# ── 必填（缺失时应用拒绝启动）──────────────────────────
# Postgres 连接串
DATABASE_URL=postgres://postgres:postgres@localhost:35432/fraxtal

# 会话签名密钥（至少 32 个字符，生产环境务必随机生成）
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

# ── 预留（后续 LLM 相关变更启用）──────────────────────
# LLM_BASE_URL=
# LLM_API_KEY=
# LLM_MODEL=
# LLM_MODEL_ASK=
# LLM_MODEL_COMPILE=

# ── 前端数据后端切换（mock | real，默认 mock）────────
# mock：localStorage 持久化的前端 mock（阶段一）；real：HTTP 后端（阶段二，当前为空壳占位）
NEXT_PUBLIC_DATA_BACKEND=mock
