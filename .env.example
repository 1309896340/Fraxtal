# ── 必填（缺失时应用拒绝启动）──────────────────────────
# Postgres 连接串
DATABASE_URL=postgres://postgres:postgres@localhost:35432/fraxtal

# 会话签名密钥（至少 32 个字符，生产环境务必随机生成）
JWT_SECRET=change-me-to-a-random-string-at-least-32-chars

